{
  "_comment": "PhishGuard feature + scoring configuration. Edit values here to tune the rule engine; feature_order must match the columns used to train models/phishguard_rf.pkl (re-run train.py after changing it).",
  "max_url_length": 2048,
  "allowed_schemes": ["http", "https", "ftp", "ftps"],

  "feature_order": [
    "url_length",
    "domain_length",
    "path_length",
    "query_length",
    "num_dots",
    "num_hyphens",
    "domain_hyphens",
    "num_digits",
    "domain_digits",
    "digit_ratio",
    "num_subdomains",
    "has_https",
    "has_ip_domain",
    "has_at_symbol",
    "num_suspicious_keywords",
    "num_special_chars",
    "num_query_params",
    "domain_entropy",
    "path_entropy",
    "suspicious_tld",
    "is_shortener",
    "has_punycode",
    "has_port",
    "num_path_segments",
    "num_percent_encoded",
    "double_slash_in_path",
    "brand_in_host",
    "brand_in_path"
  ],

  "feature_descriptions": {
    "url_length": "Total characters in the URL",
    "domain_length": "Characters in the hostname",
    "path_length": "Characters in the path",
    "query_length": "Characters in the query string",
    "num_dots": "Number of '.' in the URL",
    "num_hyphens": "Number of '-' in the URL",
    "domain_hyphens": "Number of '-' in the hostname",
    "num_digits": "Number of digits in the URL",
    "domain_digits": "Number of digits in the hostname",
    "digit_ratio": "Digits divided by URL length",
    "num_subdomains": "Subdomain labels (a leading 'www' is ignored)",
    "has_https": "1 if the scheme is https (scheme-less input is treated as https)",
    "has_ip_domain": "1 if the host is an IP address (incl. decimal/hex obfuscation)",
    "has_at_symbol": "1 if '@' appears anywhere in the URL",
    "num_suspicious_keywords": "Distinct phishing keywords found in host/path/query",
    "num_special_chars": "Count of special characters such as _ ? = & % ~ ! $",
    "num_query_params": "Number of query parameters",
    "domain_entropy": "Shannon entropy of the hostname (randomness)",
    "path_entropy": "Shannon entropy of the path (randomness)",
    "suspicious_tld": "1 if the TLD is commonly abused (.tk, .top, .xyz, ...)",
    "is_shortener": "1 if the domain is a known URL shortener",
    "has_punycode": "1 if the host uses punycode / non-ASCII characters",
    "has_port": "1 if a non-default port is specified",
    "num_path_segments": "Number of '/'-separated path segments",
    "num_percent_encoded": "Number of %XX encoded characters",
    "double_slash_in_path": "1 if '//' appears inside the path",
    "brand_in_host": "1 if a well-known brand appears in the host of an unrelated domain",
    "brand_in_path": "1 if a well-known brand appears in the path of an unrelated domain"
  },

  "radar_caps": {
    "url_length": 150,
    "num_subdomains": 5,
    "num_hyphens": 6,
    "num_digits": 10,
    "domain_entropy": 4.5,
    "path_entropy": 4.5,
    "num_suspicious_keywords": 4,
    "num_special_chars": 8
  },

  "suspicious_keywords": [
    "login", "log-in", "signin", "sign-in", "verify", "verification", "validate",
    "account", "password", "passwd", "secure", "security", "confirm", "banking",
    "wallet", "webscr", "authenticate", "billing", "suspend", "suspended",
    "unlock", "recover", "credential", "payment", "reactivate", "ebayisapi"
  ],

  "suspicious_tlds": [
    "tk", "ml", "ga", "cf", "gq", "xyz", "top", "click", "link", "work", "zip",
    "mov", "loan", "win", "bid", "icu", "cyou", "buzz", "rest", "monster", "sbs",
    "cfd", "support", "gdn", "men", "party", "review", "science", "date", "faces",
    "accountant", "download", "racing", "cam"
  ],

  "url_shorteners": [
    "bit.ly", "tinyurl.com", "t.co", "goo.gl", "ow.ly", "is.gd", "buff.ly",
    "cutt.ly", "rebrand.ly", "shorturl.at", "tiny.cc", "rb.gy", "s.id", "bl.ink"
  ],

  "brands": {
    "paypal": ["paypal.com", "paypal.me"],
    "apple": ["apple.com", "icloud.com"],
    "microsoft": ["microsoft.com", "microsoftonline.com", "live.com", "office.com", "outlook.com"],
    "google": ["google.com", "google.co.in", "google.co.uk", "gmail.com"],
    "amazon": ["amazon.com", "amazon.in", "amazon.co.uk", "amazon.de", "amazonaws.com"],
    "facebook": ["facebook.com", "fb.com"],
    "instagram": ["instagram.com"],
    "netflix": ["netflix.com"],
    "linkedin": ["linkedin.com"],
    "dropbox": ["dropbox.com"],
    "whatsapp": ["whatsapp.com", "whatsapp.net"],
    "binance": ["binance.com"],
    "coinbase": ["coinbase.com"],
    "metamask": ["metamask.io"],
    "ebay": ["ebay.com", "ebay.co.uk", "ebay.in"],
    "docusign": ["docusign.com", "docusign.net"],
    "adobe": ["adobe.com"],
    "dhl": ["dhl.com", "dhl.de"],
    "fedex": ["fedex.com"],
    "chase": ["chase.com"],
    "wellsfargo": ["wellsfargo.com"],
    "bankofamerica": ["bankofamerica.com"],
    "sbi": ["sbi.co.in", "onlinesbi.sbi", "sbi.bank.in"],
    "hdfcbank": ["hdfcbank.com"],
    "icicibank": ["icicibank.com"],
    "paytm": ["paytm.com"],
    "irctc": ["irctc.co.in"],
    "incometax": ["incometax.gov.in"]
  },

  "scoring": {
    "ml_weight": 0.6,
    "rule_weight": 0.4,
    "suspicious_min": 35,
    "high_min": 65
  },

  "rule_weights": {
    "ip_domain": 35,
    "userinfo_at": 25,
    "at_symbol_other": 8,
    "brand_host": 30,
    "brand_path": 10,
    "keyword_each": 7,
    "keyword_max": 21,
    "subdomains_excessive": 12,
    "subdomains_extreme": 20,
    "url_long": 6,
    "url_very_long": 12,
    "suspicious_tld": 15,
    "non_https": 10,
    "shortener": 12,
    "punycode": 15,
    "hyphens_many": 8,
    "hyphens_extreme": 14,
    "domain_digits": 8,
    "high_entropy": 8,
    "odd_port": 8,
    "many_params": 5,
    "encoded_chars": 5,
    "double_slash": 5
  },

  "rule_thresholds": {
    "subdomains_excessive": 3,
    "subdomains_extreme": 5,
    "url_long": 75,
    "url_very_long": 120,
    "hyphens_many": 2,
    "hyphens_extreme": 4,
    "domain_digits": 4,
    "high_entropy": 3.9,
    "high_entropy_min_length": 14,
    "many_params": 6,
    "encoded_chars": 3
  }
}
